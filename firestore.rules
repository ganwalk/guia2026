rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email in [
               'rafael.lopezc@gmail.com',
               'minutoindie@gmail.com',
               'armandocustodio0@gmail.com'
             ];
    }

    match /submissions2026_v4/{docId} {

      // Qualquer um pode ler lançamentos aprovados.
      // Apenas admins podem ler os pendentes.
      allow read: if resource.data.status == 'approved' || isAdmin();

      // Admin pode criar com qualquer status; qualquer um pode submeter nova inclusão ou solicitar alteração.
      allow create: if isAdmin()
                    || (request.resource.data.status == 'pending'
                        && request.resource.data.keys().hasAll([
                             'artist', 'uf', 'type', 'date',
                             'title', 'label', 'fonte', 'timestamp'
                           ]))
                    || (request.resource.data.status == 'pending'
                        && request.resource.data.requestType == 'change'
                        && request.resource.data.keys().hasAll([
                             'artist', 'uf', 'type', 'date',
                             'title', 'label', 'fonte', 'timestamp',
                             'requestType', 'originalId', 'motivo'
                           ]));

      // Apenas admins podem aprovar (update) ou descartar (delete).
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

  }
}
