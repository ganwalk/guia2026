rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /submissions2026_v4/{docId} {

      // Qualquer um pode ler lançamentos aprovados.
      // Apenas o admin pode ler os pendentes.
      allow read: if resource.data.status == 'approved'
                  || (request.auth != null
                      && request.auth.token.email == 'admin@guia26.com');

      // Qualquer usuário autenticado (incluindo anônimo) pode criar
      // uma submissão — mas apenas com status 'pending' e campos obrigatórios.
      allow create: if request.auth != null
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasAll([
                         'artist', 'uf', 'type', 'date',
                         'title', 'label', 'fonte', 'timestamp'
                       ]);

      // Apenas o admin pode aprovar (update) ou descartar (delete).
      allow update: if request.auth != null
                    && request.auth.token.email == 'admin@guia26.com';

      allow delete: if request.auth != null
                    && request.auth.token.email == 'admin@guia26.com';
    }

  }
}
